# ── Argo CD (플랫폼 운영자만 보관) ────────────────────────
# Argo CD Web UI 주소 (ngrok 사용 시 해당 URL 입력)
ARGOCD_SERVER=https://your-argocd-url.ngrok-free.app

# Argo CD admin 계정 토큰
# 발급: argocd account generate-token --account admin
ARGOCD_ADMIN_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...

# ── 공유 시크릿 (사용자 GitHub Secret에 REGISTER_SECRET으로 등록) ──
# 충분히 긴 랜덤 문자열 권장 (예: openssl rand -hex 32)
REGISTER_SECRET=your-strong-shared-secret-here

# ── 서버 설정 ──────────────────────────────────────────────
PORT=3000
